#!/bin/sh
# Runs loft-herdr for Herdr: the binary downloaded next to this script, else the one built in this checkout.
DIR=$(cd "$(dirname "$0")" && pwd)
for b in "${LOFT_HERDR_BIN:-}" "$DIR/loft-herdr-bin" "$DIR/../target/release/loft-herdr"; do
  if [ -n "$b" ] && [ -x "$b" ]; then exec "$b" "$@"; fi
done
echo "loft-herdr isn't installed here. In Loft, open Settings → Herdr UI and set it up." >&2
if [ -t 1 ]; then sleep 30; fi
exit 1
