<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Like the main Mac app's (LoftMac.entitlements): sandboxed, so it can go through TestFlight too. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Dictation in a chat. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Images picked to send in a chat, and apps picked for the allow list. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- The Loft address the main app saved, so Loft Focus connects to the same Loft. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(LOFT_BUNDLE_ID:default=com.example.loft).shared</string>
	</array>
</dict>
</plist>
